#!/usr/bin/env bash
# jt — java training. Seu painel de controle pelo terminal.
# Uso:  ./jt <comando> [argumento]
set -u

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIAS="$RAIZ/dias"
BUILD="$RAIZ/.build"
INICIO="2026-10-14"

LOG="$RAIZ/.jt-log/sessao.log"

# grava tudo que o jt faz, pra dar pra conferir depois.
# jshell fica de fora porque e interativo.
case "${1:-}" in
  sh|jshell|lab|log|ajuda|"") ;;
  *)
    if [ -z "${JT_LOG_ATIVO:-}" ]; then
      export JT_LOG_ATIVO=1
      mkdir -p "$(dirname "$LOG")"
      {
        printf '\n===== %s · jt %s =====\n' "$(date '+%d/%m %H:%M')" "$*"
        "$0" "$@" 2>&1
      } | tee -a "$LOG"
      exit "${PIPESTATUS[0]}"
    fi
    ;;
esac

verde(){ printf '\033[32m%s\033[0m\n' "$*"; }
vermelho(){ printf '\033[31m%s\033[0m\n' "$*"; }
amarelo(){ printf '\033[33m%s\033[0m\n' "$*"; }

# pasta do dia mais recente que tenha codigo, ou a que voce passar
alvo(){
  if [ $# -gt 0 ] && [ -n "${1:-}" ]; then
    echo "$DIAS/$1"
    return
  fi
  # ignora pasta vazia: so vale a que tem .java dentro
  local d
  for d in $(ls -d "$DIAS"/dia* 2>/dev/null | sort -r); do
    if ls "$d"/*.java >/dev/null 2>&1 || [ -f "$d/pom.xml" ]; then echo "$d"; return; fi
  done
  ls -d "$DIAS"/dia* 2>/dev/null | sort | tail -1
}

# descobre o nome completo da classe principal: le a linha "package" do Main.java
classe_principal(){
  local d="$1" mj pkg
  mj=$(find "$d" -name Main.java 2>/dev/null | head -1)
  [ -n "$mj" ] || { echo "Main"; return; }
  pkg=$(grep -m1 '^[[:space:]]*package[[:space:]]' "$mj" | sed 's/^[[:space:]]*package[[:space:]]*//; s/[[:space:]]*;.*//')
  if [ -n "$pkg" ]; then echo "$pkg.Main"; else echo "Main"; fi
}

# compila o dia e ecoa "pasta_onde_rodar|classpath|classe_principal".
# dia com pom.xml vai pelo maven; o resto vai pelo javac de sempre.
compilar(){
  local d="$1"
  if [ -f "$d/pom.xml" ]; then
    # se o mvn nao estiver no PATH, usa o que vem dentro do IntelliJ
    local MVN="mvn"
    if ! command -v mvn >/dev/null 2>&1; then
      local m
      for m in "/c/Program Files/JetBrains"/*/plugins/maven/lib/maven3/bin/mvn                "$HOME/AppData/Local/JetBrains"/*/plugins/maven/lib/maven3/bin/mvn; do
        [ -x "$m" ] && MVN="$m" && break
      done
    fi
    if [ "$MVN" = "mvn" ] && ! command -v mvn >/dev/null 2>&1; then
      printf 'o mvn nao esta no PATH.
acrescente no fim do seu ~/.bashrc:
  export PATH="$PATH:%s"
depois: source ~/.bashrc
'         "/c/Program Files/JetBrains/IntelliJ IDEA Community Edition 2024.3.3/plugins/maven/lib/maven3/bin" > /tmp/jt_erro
      return 1
    fi
    # build-classpath escreve em target/cp.txt o caminho dos .jar das dependencias
    ( cd "$d"       && "$MVN" -q compile       && "$MVN" -q dependency:build-classpath -Dmdep.outputFile=target/cp.txt ) > /tmp/jt_erro 2>&1 || return 1
    local libs=""
    [ -s "$d/target/cp.txt" ] && libs=";$(tr -d '
' < "$d/target/cp.txt")"
    echo "$d|target/classes$libs|$(classe_principal "$d")"
  else
    mkdir -p "$BUILD"; rm -f "$BUILD"/*.class 2>/dev/null
    javac -d "$BUILD" "$d"/*.java 2>/tmp/jt_erro || return 1
    echo "$RAIZ|$BUILD|$(classe_principal "$d")"
  fi
}

# um dia e "web" quando o pom pede o spring-boot-starter-web.
# dia web sobe um servidor e NAO termina sozinho.
eh_web(){ [ -f "$1/pom.xml" ] && grep -q 'spring-boot-starter-web' "$1/pom.xml"; }

PORTA=8080

# roda o dia e guarda tudo em $2.
#   dia normal : roda e espera terminar, como sempre.
#   dia web    : sobe o servidor, espera a porta atender, dispara as
#                requisicoes de requisicoes.txt com curl e encerra.
rodar_saida(){
  local alvo_cp="$1" arq="$2" d="$3"
  local dir cp cls
  dir="${alvo_cp%%|*}"
  cp=$(echo "$alvo_cp" | cut -d'|' -f2)
  cls=$(echo "$alvo_cp" | cut -d'|' -f3)

  if ! eh_web "$d"; then
    ( cd "$dir" && java -cp "$cp" "$cls" ) > "$arq" 2>&1
    return 0
  fi

  # a saida do programa e a das requisicoes vao para arquivos SEPARADOS.
  # o java mantem seu proprio ponto de escrita no arquivo; se o curl
  # escrevesse no mesmo, um sobrescreveria o outro.
  local app=/tmp/jt_app http=/tmp/jt_http
  : > "$app"; : > "$http"
  ( cd "$dir" && exec java -cp "$cp" "$cls" ) > "$app" 2>&1 &
  local pid=$! i=0 pronto=nao
  # espera o servidor atender (ate 90s — a 1a build baixa o Spring inteiro)
  while [ $i -lt 90 ]; do
    if curl -s -o /dev/null -m 2 "http://localhost:$PORTA/"; then pronto=sim; break; fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 1; i=$((i+1))
  done

  if [ "$pronto" = "nao" ]; then
    echo "--- o servidor nao subiu na porta $PORTA ---" >> "$http"
  elif [ -f "$d/requisicoes.txt" ]; then
    local linha metodo caminho corpo cod
    while IFS= read -r linha || [ -n "$linha" ]; do
      linha="${linha%$'\r'}"
      [ -z "$linha" ] && continue
      case "$linha" in \#*) continue ;; esac
      metodo=$(printf '%s' "$linha" | awk '{print $1}')
      caminho=$(printf '%s' "$linha" | awk '{print $2}')
      corpo=$(printf '%s' "$linha" | cut -s -d' ' -f3-)
      if [ -n "$corpo" ]; then
        cod=$(curl -s -o /tmp/jt_resp -w '%{http_code}' \
                   -X "$metodo" -H "Content-Type: application/json" \
                   -d "$corpo" "http://localhost:$PORTA$caminho")
      else
        cod=$(curl -s -o /tmp/jt_resp -w '%{http_code}' \
                   -X "$metodo" "http://localhost:$PORTA$caminho")
      fi
      printf -- '--- %s %s -> %s ---\n' "$metodo" "$caminho" "$cod" >> "$http"
      cat /tmp/jt_resp >> "$http"
      printf '\n' >> "$http"
    done < "$d/requisicoes.txt"
  fi

  kill "$pid" 2>/dev/null
  sleep 1
  kill -9 "$pid" 2>/dev/null
  wait "$pid" 2>/dev/null

  # primeiro o que o programa imprimiu, depois as respostas HTTP
  cat "$app" "$http" > "$arq"
  return 0
}

case "${1:-ajuda}" in

  novo|criar|new)
    n="${2:-}"
    if [ -z "$n" ]; then
      ultimo=$(ls -d "$DIAS"/dia* 2>/dev/null | sort | tail -1)
      num=$(( $(basename "${ultimo:-dia00}" | tr -dc '0-9') + 1 ))
      n=$(printf "dia%02d" "$num")
    fi
    mkdir -p "$DIAS/$n"
    if [ ! -f "$DIAS/$n/Main.java" ]; then
      cat > "$DIAS/$n/Main.java" <<'JAVA'
public class Main {
    public static void main(String[] args) {
        System.out.println("comeca aqui");
    }
}
JAVA
    fi
    verde "criado: dias/$n/Main.java"
    echo "agora:  ./jt run"
    ;;

  run|r|rodar)
    d=$(alvo "${2:-}")
    [ -d "$d" ] || { vermelho "nao achei a pasta do dia"; exit 1; }
    if alvo_cp=$(compilar "$d"); then
      echo "--- saida ---"
      if eh_web "$d"; then
        amarelo "dia web: o servidor fica no ar. abra http://localhost:$PORTA/leads no navegador."
        amarelo "pra parar: Ctrl+C aqui no terminal."
      fi
      ( cd "${alvo_cp%%|*}" && java -cp "$(echo "$alvo_cp" | cut -d'|' -f2)" "$(echo "$alvo_cp" | cut -d'|' -f3)" )
      echo "-------------"
      verde "compilou e rodou: $(basename "$d")"
    else
      vermelho "nao compilou:"
      cat /tmp/jt_erro
      exit 1
    fi
    ;;

  sh|jshell|lab)
    amarelo "jshell — laboratorio. /exit pra sair, /help pra ajuda."
    jshell
    ;;

  test|t|teste|testar)
    d=$(alvo "${2:-}")
    esperado="$d/esperado.txt"
    [ -f "$esperado" ] || { amarelo "sem esperado.txt em $(basename "$d") — nada a conferir"; exit 0; }
    alvo_cp=$(compilar "$d") || { vermelho "nao compilou:"; cat /tmp/jt_erro; exit 1; }
    eh_web "$d" && amarelo "dia web: subindo o servidor e chamando os enderecos..."
    rodar_saida "$alvo_cp" /tmp/jt_saida "$d"
    # normaliza fim de linha (java no Windows gera \r\n) e espaco no fim
    tr -d '\r' < /tmp/jt_saida | sed -e 's/[[:space:]]*$//' > /tmp/jt_a
    tr -d '\r' < "$esperado"   | sed -e 's/[[:space:]]*$//' > /tmp/jt_b
    if diff -q /tmp/jt_a /tmp/jt_b >/dev/null; then
      verde "PASSOU  $(basename "$d")"
    else
      vermelho "FALHOU  $(basename "$d")"
      echo "--- esperado ---"; cat /tmp/jt_b
      echo "--- recebido ---"; cat /tmp/jt_a
      echo "--- diferenca ---"; diff /tmp/jt_b /tmp/jt_a | head -10
      exit 1
    fi
    ;;

  ok|done|feito|pronto)
    cd "$RAIZ" || exit 1
    [ -d .git ] || { git init -q && git branch -M main; }
    # sem identidade o git recusa o commit — avisa em vez de falhar calado
    if ! git config user.email >/dev/null 2>&1; then
      vermelho "o git nao sabe quem voce e. rode uma vez:"
      echo "  git config --global user.name \"Seu Nome\""
      echo "  git config --global user.email \"seu@email.com\""
      exit 1
    fi
    d=$(basename "$(alvo "")")
    git add -A
    if git diff --cached --quiet; then
      amarelo "nada novo pra commitar"
    else
      if git commit -q -m "${2:-$d concluido}"; then
        verde "commit feito: ${2:-$d concluido}"
      else
        vermelho "o commit FALHOU — leia a mensagem acima"
        exit 1
      fi
    fi
    if git remote get-url origin >/dev/null 2>&1; then
      git push -q origin main && verde "enviado pro GitHub" || vermelho "push falhou — confere o remote"
    else
      amarelo "sem remote. pra ligar no GitHub:"
      echo "  git remote add origin https://github.com/SEU-USUARIO/java-junior.git"
      echo "  git push -u origin main"
    fi
    ;;

  hoje|dia)
    hoje=$(date +%Y-%m-%d)
    di=$(( ( $(date -d "$hoje" +%s) - $(date -d "$INICIO" +%s) ) / 86400 + 1 ))
    feitos=$(ls -d "$DIAS"/dia* 2>/dev/null | wc -l)
    echo "dia do plano: $di   ·   pastas criadas: $feitos"
    [ "$feitos" -lt "$di" ] && amarelo "voce esta $(( di - feitos )) dia(s) atras. nao tenta recuperar tudo: faz o de hoje."
    [ "$feitos" -ge "$di" ] && verde "em dia."
    ;;

  log|diario)
    if [ ! -f "$LOG" ]; then amarelo "nada gravado ainda"; exit 0; fi
    n="${2:-60}"
    echo "--- ultimas $n linhas de $LOG ---"
    tail -n "$n" "$LOG"
    ;;

  streak|sequencia)
    cd "$RAIZ" || exit 1
    [ -d .git ] || { amarelo "sem git ainda"; exit 0; }
    echo "commits por dia (ultimos 14):"
    git log --since="14 days ago" --date=short --pretty=format:%ad 2>/dev/null | sort | uniq -c | awk '{printf "  %s  %s\n", $2, $1}'
    ;;

  *)
    cat <<'AJUDA'
jt — java training

  ./jt novo [diaNN]   cria a pasta do dia com Main.java
  ./jt rodar          compila e roda  (tambem: run, r)
  ./jt lab            abre o jshell   (tambem: sh)
  ./jt teste          confere a saida (tambem: test, t)
  ./jt ok "mensagem"  commita e envia  (tambem: feito, pronto)
  ./jt hoje           diz em que dia do plano voce esta
  ./jt log [n]        mostra o que foi gravado (padrao 60 linhas)
  ./jt streak         commits por dia nas ultimas 2 semanas

atalho: coloque no seu ~/.bashrc
  alias jt='~/java-junior/jt'
AJUDA
    ;;
esac
